<Window x:Class="VatisSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VatisSync.ViewModels"
        xmlns:ctl="clr-namespace:VatisSync.Controls"
        xmlns:core="clr-namespace:VatisSync.Core;assembly=VatisSync.Core"
        Title="vATIS-Sync" Width="900" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: always visible -->
        <Border Grid.Row="0" Padding="8,10,16,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource StartStopButton}" Command="{Binding StartStopCommand}"
                        FontSize="15" FontWeight="SemiBold" Padding="22,8" VerticalAlignment="Center"
                        AutomationProperties.Name="Start or stop syncing">
                    <StackPanel Orientation="Horizontal">
                        <!-- Play while stopped, stop square while syncing -->
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StartStopText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding SettingsNote}" Foreground="#B45309" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" x:Name="SettingsButton" Click="OnOpenSettings" MinWidth="40" Padding="10,6"
                        VerticalAlignment="Center" ToolTip="Settings" AutomationProperties.Name="Settings">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="18"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: the Overview tile, then the airports -->
            <Border Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                <DockPanel>
                    <!-- Overview: a tile of its own, not a row of the list -->
                    <Border DockPanel.Dock="Top" Margin="8,10,8,0" Padding="12,10" CornerRadius="4" Cursor="Hand"
                            AutomationProperties.Name="Overview">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ShowOverviewCommand}"/>
                        </Border.InputBindings>
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1F2937"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverviewSelected}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#C9D3E0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverviewSelected}" Value="True">
                                        <Setter Property="Background" Value="#1F6FD6"/>
                                        <Setter Property="BorderBrush" Value="#1F6FD6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Headline}" FontSize="12" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="AIRPORTS" FontSize="11" FontWeight="SemiBold"
                               Style="{StaticResource Hint}" Margin="21,18,8,4"/>

                    <!-- Where the airports come from: the open vATIS profile -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,12">
                        <TextBlock Text="{Binding DiscoveryText}" Style="{StaticResource Hint}" FontSize="12" Margin="2,0,2,8"/>
                        <Button Command="{Binding RetryDiscoveryCommand}" Padding="10,6" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DiscoveryButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid>
                    <ListBox Margin="8,0" ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport, Mode=TwoWay}"
                             Visibility="{Binding HasAirports, Converter={StaticResource BoolToVisibility}}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AirportViewModel}">
                                <DockPanel Margin="11,5,9,5" Background="Transparent">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Hide from this list (its settings are kept)" Click="OnRemoveAirport"/>
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Ellipse DockPanel.Dock="Right" Width="9" Height="9" Margin="8,0,2,0" VerticalAlignment="Center"
                                             Stroke="#16A34A" StrokeThickness="1.5">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Button DockPanel.Dock="Right" MinWidth="22" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" ToolTip="Hide from the list. Its settings are kept."
                                            AutomationProperties.Name="Remove airport"
                                            Command="{Binding DataContext.RemoveAirportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE738;" FontSize="12" Foreground="#B45309"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Icao}" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                            <Setter Property="ToolTip" Value="No longer in your vATIS profile. Its settings are kept."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Started">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                            <Setter Property="Foreground" Value="#1F6FD6"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Stale">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Nothing listed yet: they appear as soon as the profile can be read -->
                    <StackPanel Margin="12,6,12,0" VerticalAlignment="Top"
                                Visibility="{Binding HasNoAirports, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No airports yet" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="They appear here as soon as the app can read the profile open in vATIS."/>
                    </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- RIGHT: the Overview, or the selected airport -->
            <Grid Grid.Column="1" Margin="16,12,16,12">

                <!-- Overview: stations and log -->
                <DockPanel Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Overview" FontSize="22" FontWeight="SemiBold" Foreground="#1F6FD6"/>
                        <TextBlock Text="All your stations and the activity log" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Last sync: " Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding LastSync}" Margin="0,0,24,0"/>
                        <TextBlock Text="Next sync: " Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding NextSync}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Your stations" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="90"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="90"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="4" BorderThickness="1" ClipToBounds="True" BorderBrush="#FFACACAC">
                        <ListView ItemsSource="{Binding Stations}" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Station" Width="110" DisplayMemberBinding="{Binding Key}"/>
                                    <GridViewColumn Header="Connection" Width="120" DisplayMemberBinding="{Binding Connection}"/>
                                    <GridViewColumn Header="D-ATIS" Width="140" DisplayMemberBinding="{Binding Datis}"/>
                                    <GridViewColumn Header="Updated" Width="90" DisplayMemberBinding="{Binding LastUpdated}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,26,0,8">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}"/>
                            <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox Grid.Row="2" x:Name="LogList" Padding="10,8" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogLine}">
                                    <Border CornerRadius="3" Padding="6,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                        <Setter Property="Background" Value="#FFEAF6EE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                        <Setter Property="Background" Value="#FFFDF3DC"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                        <Setter Property="Background" Value="#FFFBE9E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                            <Setter Property="Foreground" Value="#FF15803D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                            <Setter Property="Foreground" Value="#FF9A5200"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                            <Setter Property="Foreground" Value="#FFB42323"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <!-- One airport -->
                <ContentControl Content="{Binding SelectedAirport}"
                                Visibility="{Binding IsAirportSelected, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:AirportViewModel}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Icao}" FontSize="22" FontWeight="SemiBold"/>
                                    <Border Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock TextWrapping="Wrap" Foreground="#1F2937"
                                                   Text="This airport is no longer in your vATIS profile. Its settings are saved and come back if it returns, but nothing is synced for it. Use the minus button in the list to hide it."/>
                                    </Border>
                                </StackPanel>

                                <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
                                    <TabItem Header="Summary" Padding="14,6">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="16,14,16,16">
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Content="Update now" Command="{Binding Summary.UpdateNowCommand}"/>
                                                    <CheckBox IsChecked="{Binding Summary.ShowChanges}" VerticalAlignment="Center"
                                                              Content="Show what was changed from the real-world text"/>
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="22,0,0,6"
                                                            Visibility="{Binding Summary.ShowChanges, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="removed" Foreground="#B91C1C" Background="#FDECEC" TextDecorations="Strikethrough" Padding="4,0" FontSize="11"/>
                                                    <TextBlock Text="put in" Foreground="#15803D" Background="#E7F5EC" FontWeight="SemiBold" Padding="4,0" Margin="8,0,0,0" FontSize="11"/>
                                                    <TextBlock Text="unchanged" Style="{StaticResource Hint}" Padding="4,0" Margin="8,0,0,0" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary.Note}" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,8"/>

                                                <Border Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Summary.Warning}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Summary.Warning}" TextWrapping="Wrap" Foreground="#1F2937"/>
                                                </Border>

                                                <TextBlock Text="{Binding Summary.Message}" Margin="0,4,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl ItemsSource="{Binding Summary.Stations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:StationSummary}">
                                                            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                                    BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Key}" FontSize="16" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Hint}" FontSize="12"/>
                                                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource Hint}" FontSize="12"/>

                                                                    <TextBlock Text="{Binding Problem}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"/>

                                                                    <StackPanel Visibility="{Binding Available, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="Airport conditions" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                                            <ctl:DiffTextBlock Segments="{Binding ConditionsDiff}" ShowChanges="{Binding ShowChanges}"
                                                                                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5" Foreground="#1F2937"/>
                                                                        </Border>
                                                                        <TextBlock Text="NOTAMs" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                                            <ctl:DiffTextBlock Segments="{Binding NotamsDiff}" ShowChanges="{Binding ShowChanges}"
                                                                                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5" Foreground="#1F2937"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Settings" Padding="14,6">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="16,14,16,16">
                                                <TextBlock Text="Rules" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                                                <CheckBox IsChecked="{Binding UseDefaultRules}" Content="Use the default settings" Margin="0,0,0,8"/>
                                                <TextBlock Style="{StaticResource Hint}"
                                                           Visibility="{Binding UseDefaultRules, Converter={StaticResource BoolToVisibility}}"
                                                           Text="This airport follows the rules chosen under Settings (the gear). Untick to set them for this airport only."/>
                                                <ItemsControl ItemsSource="{Binding Rules.Rules}"
                                                              Visibility="{Binding CustomRules, Converter={StaticResource BoolToVisibility}}"/>

                                                <TextBlock Text="Frequencies" Style="{StaticResource Section}"/>
                                                <CheckBox IsChecked="{Binding UseDefaultFrequencies}" Content="Use the default settings" Margin="0,0,0,8"/>
                                                <TextBlock Style="{StaticResource Hint}"
                                                           Visibility="{Binding UseDefaultFrequencies, Converter={StaticResource BoolToVisibility}}"
                                                           Text="This airport follows the frequency settings chosen under Settings (the gear). Untick to set them for this airport only."/>
                                                <StackPanel Visibility="{Binding CustomFrequencies, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                               Text="Keep the text, remove the instruction, or replace the frequency with one you type. The ATIS and Flight Service frequencies are never changed."/>
                                                    <ItemsControl ItemsSource="{Binding Frequencies.Rows}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- MESSAGES: errors and warnings stay until dismissed or fixed; confirmations clear themselves -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Notices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type core:Notice}">
                    <Border x:Name="Bar" Padding="14,9" BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FDECEC"/>
                                <Setter Property="BorderBrush" Value="#DC2626"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                        <Setter Property="BorderBrush" Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Info">
                                        <Setter Property="Background" Value="#E7F5EC"/>
                                        <Setter Property="BorderBrush" Value="#16A34A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" MinWidth="28" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message"
                                    Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" FontSize="12"/>
                            </Button>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE783;"/>
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                <Setter Property="Text" Value="&#xE7BA;"/>
                                                <Setter Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Info">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                <Setter Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#1F2937"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
