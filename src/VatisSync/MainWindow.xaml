<Window x:Class="VatisSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VatisSync.ViewModels"
        xmlns:ctl="clr-namespace:VatisSync.Controls"
        xmlns:core="clr-namespace:VatisSync.Core;assembly=VatisSync.Core"
        Title="vATIS-Sync" Width="900" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- One card for every message. Banners (errors, warnings) and toasts (confirmations) share it. -->
        <DataTemplate x:Key="NoticeCard" DataType="{x:Type core:Notice}">
                    <Border x:Name="Bar" Padding="14,9" BorderThickness="1" CornerRadius="6">
                <Border.LayoutTransform><ScaleTransform x:Name="BarScale" ScaleY="1"/></Border.LayoutTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ErrorWash}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorMark}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter Property="Background" Value="{DynamicResource WarningWash}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningMark}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Info">
                                        <Setter Property="Background" Value="{DynamicResource SuccessWash}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessMark}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" MinWidth="28" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message"
                                    Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE711;" FontSize="12"/>
                            </Button>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE783;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                <Setter Property="Text" Value="&#xE7BA;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Info">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextStrong}"/>
                        </DockPanel>
                    </Border>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Bar">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding IsFading}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: always visible -->
        <Border Grid.Row="0" Padding="8,10,16,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderSubtle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource StartStopButton}" Command="{Binding StartStopCommand}"
                        FontSize="15" FontWeight="SemiBold" Padding="22,8" VerticalAlignment="Center"
                        AutomationProperties.Name="Start or stop syncing">
                    <StackPanel Orientation="Horizontal">
                        <!-- Play while stopped, stop square while syncing -->
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StartStopText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="SettingsButton" Click="OnOpenSettings" MinWidth="40" Padding="10,6"
                        VerticalAlignment="Center" ToolTip="Settings" AutomationProperties.Name="Settings">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="18"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: the Overview tile, then the airports -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SidebarBorder}">
                <DockPanel>
                    <!-- Overview: a tile of its own, not a row of the list -->
                    <!-- A real button, so Tab, Enter and Space reach it. Styled like an airport row (see SidebarTile in App.xaml). -->
                    <Button DockPanel.Dock="Top" Margin="8,10,8,0" Style="{StaticResource SidebarTile}"
                            Command="{Binding ShowOverviewCommand}" AutomationProperties.Name="Overview">
                        <!-- One line: the status already shows in the header, so the tile does not repeat it -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock DockPanel.Dock="Top" Text="AIRPORTS" FontSize="12" FontWeight="SemiBold"
                               Style="{StaticResource Hint}" Margin="21,18,8,4"/>

                    <!-- Where the airports come from: the open vATIS profile -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,12">
                        <!-- A dot in front says at a glance whether vATIS was found (green) or is still being looked for (amber) -->
                        <DockPanel Margin="2,0,2,8">
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,7,0" VerticalAlignment="Top">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource WarningMark}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscoveryFound}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessMark}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DiscoveryText}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap"/>
                        </DockPanel>
                        <!-- White, so it stands out from the gray sidebar it sits on -->
                        <Button Command="{Binding RetryDiscoveryCommand}" Padding="10,6" HorizontalAlignment="Stretch"
                                Background="{DynamicResource Surface}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DiscoveryButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid>
                    <ListBox Margin="8,0" ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport, Mode=TwoWay}"
                             Visibility="{Binding HasAirports, Converter={StaticResource BoolToVisibility}}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AirportViewModel}">
                                <DockPanel Margin="11,5,9,5" Background="Transparent">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Hide from this list (its settings are kept)" Click="OnRemoveAirport"/>
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Ellipse DockPanel.Dock="Right" Width="9" Height="9" Margin="8,0,2,0" VerticalAlignment="Center"
                                             Stroke="{DynamicResource SuccessMark}" StrokeThickness="1.5">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessMark}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Button DockPanel.Dock="Right" MinWidth="22" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" ToolTip="Hide from the list. Its settings are kept."
                                            AutomationProperties.Name="Remove airport"
                                            Command="{Binding DataContext.RemoveAirportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE738;" FontSize="12" Foreground="{DynamicResource WarningText}"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Icao}" FontSize="15">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                                            <Setter Property="ToolTip" Value="No longer in your vATIS profile. Its settings are kept."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Started">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Stale">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Desynced">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="ToolTip" Value="You disregarded a change, so vATIS differs from the real-world ATIS."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Nothing listed yet: they appear as soon as the profile can be read -->
                    <StackPanel Margin="12,6,12,0" VerticalAlignment="Top"
                                Visibility="{Binding HasNoAirports, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No airports yet" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="They appear here as soon as the app can read the profile open in vATIS."/>
                    </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- RIGHT: the Overview, or the selected airport -->
            <Grid Grid.Column="1" Margin="16,12,16,12">

                <!-- Overview: stations and log -->
                <!-- The page fills the window; when the window is too short it keeps a minimum height and scrolls instead of crushing the table and log -->
                <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}">
                <DockPanel MinHeight="440" Height="{Binding ViewportHeight, ElementName=OverviewScroll}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Overview" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="All your stations and the activity log" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <!-- The two times that matter most on this page: small label over a clear value -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="Last sync" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding LastSync}" FontSize="15" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastSync}" Value="Never">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Next sync" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <!-- A dash while there is no next sync, so there is never a blank where a time goes -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding NextSync}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NextSync}" Value="">
                                                <Setter Property="Text" Value="&#x2014;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Your stations" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="64"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="64"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="4" BorderThickness="1" ClipToBounds="True" BorderBrush="{DynamicResource ControlBorder}">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Column header, left-aligned like the cells under it. The widths here and in the row template must match. -->
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}"
                                Background="{DynamicResource TabBackground}" Padding="14,7">
                            <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextSecondary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Station"/>
                                <TextBlock Grid.Column="1" Text="Connection"/>
                                <TextBlock Grid.Column="2" Text="D-ATIS"/>
                                <TextBlock Grid.Column="3" Text="Updated"/>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1" ItemsSource="{Binding Stations}" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Your stations">
                            <ListView.ItemContainerStyle>
                                <!-- Rows are read-only: no selection, no focus box, just a faint line between them. -->
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}" Padding="14,5">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StationRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" Foreground="{DynamicResource TextStrong}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <!-- Same dots as the sidebar: filled green when connected, an empty ring when not -->
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" StrokeThickness="1.5" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource SuccessMark}"/>
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessMark}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Connection}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Datis}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Datis}" Value="No current D-ATIS">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding LastUpdated}" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- Shown while the list is empty, which is until syncing has started -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,0" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No stations yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,4,0,0"
                                       Text="Press Start. Your stations show up here once vATIS-Sync has read them."/>
                        </StackPanel>
                        </Grid>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,26,0,8">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}"/>
                            <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="2">
                        <ListBox x:Name="LogList" Padding="10,8" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogLine}">
                                    <Border CornerRadius="3" Padding="6,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessWash}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                        <Setter Property="Background" Value="{DynamicResource WarningWash}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource ErrorWash}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Shown while the log is empty, so an empty box never looks broken -->
                        <TextBlock Text="Nothing yet. What the app does shows up here." TextAlignment="Center" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogLines.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                    </Grid>
                </DockPanel>
                </ScrollViewer>

                <!-- One airport -->
                <ContentControl Content="{Binding SelectedAirport}"
                                Visibility="{Binding IsAirportSelected, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:AirportViewModel}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Icao}" FontSize="22" FontWeight="SemiBold"/>
                                    <!-- A change was disregarded: vATIS differs from the real-world ATIS until the controller resyncs -->
                                    <Border Background="{DynamicResource WarningWash}" BorderBrush="{DynamicResource WarningMark}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                                            Visibility="{Binding IsDesynced, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Resync" Padding="14,4" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ResyncAirportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Resync this airport with the real-world ATIS"/>
                                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextStrong}"
                                                       Text="You disregarded a change, so vATIS differs from the real-world ATIS. Resync shows you the change again so you can apply it."/>
                                        </DockPanel>
                                    </Border>
                                    <Border Background="{DynamicResource WarningWash}" BorderBrush="{DynamicResource WarningMark}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextStrong}"
                                                   Text="This airport is no longer in your vATIS profile. Its settings are saved and come back if it returns, but nothing is synced for it. Use the minus button in the list to hide it."/>
                                    </Border>
                                </StackPanel>

                                <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
                                    <TabItem Header="Summary" Padding="14,6">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="16,14,16,16">
                                                <!-- The action sits next to the preview it refreshes, not at the far edge -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Content="Update now" Command="{Binding Summary.UpdateNowCommand}" Margin="0,0,16,0"/>
                                                    <CheckBox IsChecked="{Binding Summary.ShowChanges}" VerticalAlignment="Center"
                                                              Content="Show what was changed from the real-world text"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="22,0,0,6"
                                                            Visibility="{Binding Summary.ShowChanges, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="removed" Foreground="{DynamicResource ErrorText}" Background="{DynamicResource ErrorWash}" TextDecorations="Strikethrough" Padding="4,0" FontSize="12"/>
                                                    <TextBlock Text="put in" Foreground="{DynamicResource SuccessText}" Background="{DynamicResource SuccessWash}" FontWeight="SemiBold" Padding="4,0" Margin="8,0,0,0" FontSize="12"/>
                                                    <TextBlock Text="unchanged" Style="{StaticResource Hint}" Padding="4,0" Margin="8,0,0,0" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary.Note}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>

                                                <Border Background="{DynamicResource WarningWash}" BorderBrush="{DynamicResource WarningMark}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Summary.Warning}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Summary.Warning}" TextWrapping="Wrap" Foreground="{DynamicResource TextStrong}"/>
                                                </Border>

                                                <TextBlock Text="{Binding Summary.Message}" Margin="0,4,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl ItemsSource="{Binding Summary.Stations}" AlternationCount="100">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:StationSummary}">
                                                            <!-- No box of its own (the tab already has one): a divider line separates stations, none above the first -->
                                                            <Border>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                                                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                                        <Setter Property="Padding" Value="0,14,0,4"/>
                                                                        <Setter Property="Margin" Value="0,10,0,0"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                                <Setter Property="Padding" Value="0,0,0,4"/>
                                                                                <Setter Property="Margin" Value="0"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <!-- The page title already names a single station; the name is only shown to tell several apart -->
                                                                    <TextBlock Text="{Binding Key}" FontSize="15" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="1">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Hint}" FontSize="12"/>
                                                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource Hint}" FontSize="12"/>

                                                                    <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"/>

                                                                    <StackPanel Visibility="{Binding Available, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="Airport conditions" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                                                        <Border Background="{DynamicResource CodeBackground}" BorderBrush="{DynamicResource CodeBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                                            <ctl:DiffTextBlock Segments="{Binding ConditionsDiff}" ShowChanges="{Binding ShowChanges}"
                                                                                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextStrong}"/>
                                                                        </Border>
                                                                        <TextBlock Text="NOTAMs" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                                                        <Border Background="{DynamicResource CodeBackground}" BorderBrush="{DynamicResource CodeBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                                            <ctl:DiffTextBlock Segments="{Binding NotamsDiff}" ShowChanges="{Binding ShowChanges}"
                                                                                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextStrong}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Settings" Padding="14,6">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="16,14,16,16">
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                                           Text="Each airport follows the defaults chosen under Settings (the gear). Untick 'Use the default settings' to set an airport's own."/>
                                                <TextBlock Text="Rules" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                                                <CheckBox IsChecked="{Binding UseDefaultRules}" Content="Use the default settings" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding Rules.Rules}"
                                                              Visibility="{Binding CustomRules, Converter={StaticResource BoolToVisibility}}"/>

                                                <TextBlock Text="Frequencies" Style="{StaticResource Section}"/>
                                                <CheckBox IsChecked="{Binding UseDefaultFrequencies}" Content="Use the default settings" Margin="0,0,0,8"/>
                                                <StackPanel Visibility="{Binding CustomFrequencies, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                               Text="Keep the text, remove the instruction, or replace the frequency with one you type. The ATIS and Flight Service frequencies are never changed."/>
                                                    <ItemsControl ItemsSource="{Binding Frequencies.Rows}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- MESSAGES. Errors and warnings stay until dismissed or fixed: a banner along the bottom, inset like the cards. -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Banners}" ItemTemplate="{StaticResource NoticeCard}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="12,0,12,10"/></Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Confirmations clear themselves: a toast floats over the content, so nothing moves when it comes or goes. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource NoticeCard}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" MaxWidth="420"
                      Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,8,0,0"/></Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </Grid>
</Window>
