<Window x:Class="VatisSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VatisSync.ViewModels"
        Title="vATIS-Sync" Width="640" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="8" Padding="12">
        <!-- STATUS -->
        <TabItem Header="Status">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Headline}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                            FontSize="15" FontWeight="SemiBold" Padding="26,9" VerticalAlignment="Center"
                            AutomationProperties.Name="Start or stop syncing"/>
                </Grid>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Last sync: " Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding LastSync}" Margin="0,0,24,0"/>
                    <TextBlock Text="Next sync: " Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding NextSync}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="Your stations" Style="{StaticResource Section}"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Stations that are not connected are skipped on refresh. Choose which airports to connect on the Airports tab."/>
                <ListView ItemsSource="{Binding Stations}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Station" Width="110" DisplayMemberBinding="{Binding Key}"/>
                            <GridViewColumn Header="Connection" Width="120" DisplayMemberBinding="{Binding Connection}"/>
                            <GridViewColumn Header="D-ATIS" Width="140" DisplayMemberBinding="{Binding Datis}"/>
                            <GridViewColumn Header="Updated" Width="90" DisplayMemberBinding="{Binding LastUpdated}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <!-- AIRPORTS -->
        <TabItem Header="Airports">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Hint}"
                           Text="Airports to connect when you press Start. Leave this empty to follow the position you last used in CRC (tower, ground, delivery or ramp)."/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,8">
                    <TextBox Width="110" MaxLength="4" Text="{Binding NewAirport, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Airport code">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddAirportCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Add" Command="{Binding AddAirportCommand}" Margin="8,0,0,0"/>
                    <Button Content="Remove selected" Command="{Binding RemoveAirportCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport}"/>
            </DockPanel>
        </TabItem>

        <!-- RULES -->
        <TabItem Header="Rules">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Hint}"
                           Text="Rules clean real-world text that does not make sense on VATSIM. Switch off any you do not want."/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Open my rules file" Command="{Binding OpenRulesFileCommand}"/>
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="For rules of your own for a single airport."/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rules}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="22,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </TabItem>

        <!-- SETTINGS -->
        <TabItem Header="Settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Syncing" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Refresh every" VerticalAlignment="Center"/>
                        <ComboBox Width="70" Margin="8,0" SelectedValuePath="Tag" SelectedValue="{Binding IntervalMinutes}"
                                  AutomationProperties.Name="Refresh interval in minutes">
                            <ComboBoxItem Content="1" Tag="1"/>
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="5" Tag="5"/>
                            <ComboBoxItem Content="10" Tag="10"/>
                            <ComboBoxItem Content="15" Tag="15"/>
                            <ComboBoxItem Content="30" Tag="30"/>
                        </ComboBox>
                        <TextBlock Text="minutes" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Connect at most" VerticalAlignment="Center"/>
                        <ComboBox Width="70" Margin="8,0" SelectedValuePath="Tag" SelectedValue="{Binding MaxConnections}"
                                  AutomationProperties.Name="Maximum ATIS connections">
                            <ComboBoxItem Content="1" Tag="1"/>
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="3" Tag="3"/>
                            <ComboBoxItem Content="4" Tag="4"/>
                        </ComboBox>
                        <TextBlock Text="stations at once" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding AutoConnectActivePosition}" Margin="0,4"
                              Content="Follow the position I last used in CRC when no airports are chosen"/>
                    <CheckBox IsChecked="{Binding LaunchVatis}" Margin="0,4"
                              Content="Open vATIS for me if it is not running"/>

                    <TextBlock Text="Changes to a connected ATIS" Style="{StaticResource Section}"/>
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.ApprovalChoices}" DisplayMemberPath="Label"
                              SelectedValuePath="Mode" SelectedValue="{Binding Approval}" HorizontalAlignment="Left"
                              MinWidth="280" AutomationProperties.Name="When to ask before changing the ATIS"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Before a refresh changes the text of an ATIS you are connected to, you see what would change and decide. The first fill when you press Start never asks."/>

                    <TextBlock Text="This app" Style="{StaticResource Section}"/>
                    <CheckBox IsChecked="{Binding StartSyncOnLaunch}" Margin="0,4"
                              Content="Start syncing as soon as the app opens"/>
                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,4"
                              Content="Start the app when Windows starts"/>
                    <CheckBox IsChecked="{Binding StartMinimized}" Margin="0,4"
                              Content="Start minimized to the tray"/>
                    <CheckBox IsChecked="{Binding CloseToTray}" Margin="0,4"
                              Content="Keep running in the tray when I close the window"/>

                    <TextBlock Text="{Binding SettingsNote}" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- LOG -->
        <TabItem Header="Log">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Clear" Command="{Binding ClearLogCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
