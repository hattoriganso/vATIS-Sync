<Window x:Class="VatisSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VatisSync.ViewModels"
        Title="vATIS-Sync" Width="900" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: always visible -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                        FontSize="15" FontWeight="SemiBold" Padding="26,8" VerticalAlignment="Center"
                        AutomationProperties.Name="Start or stop syncing"/>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding SettingsNote}" Foreground="#B45309" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="SettingsButton" Click="OnOpenSettings" MinWidth="40" Padding="10,6"
                        VerticalAlignment="Center" ToolTip="Settings" AutomationProperties.Name="Settings">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="18"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: the Overview tile, then the airports -->
            <Border Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                <DockPanel>
                    <!-- Overview: a tile of its own, not a row of the list -->
                    <Border DockPanel.Dock="Top" Margin="8,10,8,0" Padding="12,10" CornerRadius="4" Cursor="Hand"
                            AutomationProperties.Name="Overview">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ShowOverviewCommand}"/>
                        </Border.InputBindings>
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1F2937"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverviewSelected}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#C9D3E0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverviewSelected}" Value="True">
                                        <Setter Property="Background" Value="#1F6FD6"/>
                                        <Setter Property="BorderBrush" Value="#1F6FD6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Headline}" FontSize="12" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="AIRPORTS" FontSize="11" FontWeight="SemiBold"
                               Style="{StaticResource Hint}" Margin="16,18,8,4"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8">
                        <TextBlock Text="Add an airport" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddAirportCommand}"
                                    MinWidth="50" Padding="8,3" Margin="6,0,0,0"/>
                            <TextBox MaxLength="4" CharacterCasing="Upper" VerticalContentAlignment="Center"
                                     Text="{Binding NewAirport, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Airport code">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddAirportCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AirportViewModel}">
                                <DockPanel Margin="4,5" Background="Transparent">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove from list and reset its settings" Click="OnRemoveAirport"/>
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Ellipse DockPanel.Dock="Right" Width="9" Height="9" Margin="8,0,2,0" VerticalAlignment="Center"
                                             Stroke="#16A34A" StrokeThickness="1.5">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Icao}" FontSize="14"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- RIGHT: the Overview, or the selected airport -->
            <Grid Grid.Column="1" Margin="16,12,16,12">

                <!-- Overview: stations and log -->
                <DockPanel Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Overview" FontSize="22" FontWeight="SemiBold" Foreground="#1F6FD6"/>
                        <TextBlock Text="All your stations and the activity log" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Last sync: " Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding LastSync}" Margin="0,0,24,0"/>
                        <TextBlock Text="Next sync: " Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding NextSync}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Your stations" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="90"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="90"/>
                        </Grid.RowDefinitions>
                        <ListView Grid.Row="0" ItemsSource="{Binding Stations}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Station" Width="110" DisplayMemberBinding="{Binding Key}"/>
                                    <GridViewColumn Header="Connection" Width="120" DisplayMemberBinding="{Binding Connection}"/>
                                    <GridViewColumn Header="D-ATIS" Width="140" DisplayMemberBinding="{Binding Datis}"/>
                                    <GridViewColumn Header="Updated" Width="90" DisplayMemberBinding="{Binding LastUpdated}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <DockPanel Grid.Row="1" Margin="0,14,0,4">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}"/>
                            <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox Grid.Row="2" x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </DockPanel>

                <!-- One airport -->
                <ContentControl Content="{Binding SelectedAirport}"
                                Visibility="{Binding IsAirportSelected, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:AirportViewModel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Icao}" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="Airport settings" Style="{StaticResource Hint}"/>

                                    <TextBlock Text="Stations" Style="{StaticResource Section}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Visibility="{Binding HasNoStations, Converter={StaticResource BoolToVisibility}}"
                                               Text="No D-ATIS station for this airport was found in your vATIS profile on the last run. Its settings are kept and apply as soon as one appears."/>
                                    <ItemsControl ItemsSource="{Binding Stations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:StationRow}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Key}" Width="110" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Connection}" Width="120"/>
                                                    <TextBlock Text="{Binding Datis}" Width="140"/>
                                                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource Hint}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Rules" Style="{StaticResource Section}"/>
                                    <CheckBox IsChecked="{Binding UseDefaultRules}" Content="Use the default settings" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Visibility="{Binding UseDefaultRules, Converter={StaticResource BoolToVisibility}}"
                                               Text="This airport follows the rules chosen under Settings (the gear). Untick to set them for this airport only."/>
                                    <ItemsControl ItemsSource="{Binding Rules.Rules}"
                                                  Visibility="{Binding CustomRules, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="Frequencies" Style="{StaticResource Section}"/>
                                    <CheckBox IsChecked="{Binding UseDefaultFrequencies}" Content="Use the default settings" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Visibility="{Binding UseDefaultFrequencies, Converter={StaticResource BoolToVisibility}}"
                                               Text="This airport follows the frequency settings chosen under Settings (the gear). Untick to set them for this airport only."/>
                                    <StackPanel Visibility="{Binding CustomFrequencies, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                                   Text="Keep the text, remove the instruction, or replace the frequency with one you type. The ATIS and Flight Service frequencies are never changed."/>
                                        <ItemsControl ItemsSource="{Binding Frequencies.Rows}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
