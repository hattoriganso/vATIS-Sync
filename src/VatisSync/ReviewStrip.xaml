<Window x:Class="VatisSync.ReviewStrip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vATIS-Sync: a change is waiting for your review"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="560"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}">
    <!-- A small strip in a corner of the screen. It never takes the keyboard (see OnSourceInitialized) and has no Apply:
         nothing that is typed or pressed can answer it, and it only offers to open the review window. -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlBorderStrong}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource WarningMark}"/>
            <StackPanel Grid.Column="1" Margin="14,10,12,10" VerticalAlignment="Center">
                <TextBlock Text="Waiting for your review" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="Detail" FontWeight="SemiBold" Foreground="{DynamicResource TextStrong}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <!-- Not focusable: a click works, the keyboard never lands here. The tray menu and the airport page
                     offer the same Review for anyone who works without the mouse. -->
                <Button x:Name="LaterButton" Content="Later" Focusable="False" Padding="12,5" Margin="0,0,8,0"
                        Click="OnLater" ToolTip="Hide this for a few minutes. It comes back if the change is still waiting."/>
                <Button x:Name="ReviewButton" Content="Review" Focusable="False" Padding="14,5" FontWeight="SemiBold"
                        Style="{StaticResource PrimaryButton}" Click="OnReview"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
