<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The same names as Palette.Light.xaml, for dark. Every text and background pair that appears in the app was
         checked for contrast (4.5:1 for text, 3:1 for marks and outlines); PaletteTests repeats that check, so a change
         here that breaks it fails the build. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface" Color="#FF292929"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#FF202020"/>
    <SolidColorBrush x:Key="PageBackground" Color="#FF202020"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FF262626"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="#FF3C3C3C"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="TextStrong" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFB8B8B8"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="OnFill" Color="#FFFFFFFF"/>

    <!-- Controls (buttons, inputs, tabs, dropdowns) -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FF383838"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#FF5C5C5C"/>
    <SolidColorBrush x:Key="ControlBorderStrong" Color="#FF8C8C8C"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#FF404040"/>
    <SolidColorBrush x:Key="TabBackground" Color="#FF2E2E2E"/>

    <!-- The one blue. Accent is a fill under white text and an outline on dark, so it is dark enough for the first and
         light enough for the second. Blue text uses AccentText, which is lighter. -->
    <SolidColorBrush x:Key="Accent" Color="#FF2672CC"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF1F66BD"/>
    <SolidColorBrush x:Key="AccentDark" Color="#FF1A5AA6"/>
    <SolidColorBrush x:Key="AccentText" Color="#FF6CB6FF"/>
    <SolidColorBrush x:Key="AccentWash" Color="#FF1F3F63"/>
    <SolidColorBrush x:Key="AccentWashHover" Color="#FF2C4A70"/>
    <SolidColorBrush x:Key="AccentWashPressed" Color="#FF24405F"/>
    <SolidColorBrush x:Key="OnAccentWash" Color="#FFFFFFFF"/>

    <!-- Status: text, mark (dots and borders), wash (soft background), fill (big buttons) -->
    <SolidColorBrush x:Key="SuccessText" Color="#FF62D48F"/>
    <SolidColorBrush x:Key="SuccessMark" Color="#FF3DBA6E"/>
    <SolidColorBrush x:Key="SuccessWash" Color="#FF1C3A2A"/>
    <SolidColorBrush x:Key="SuccessFill" Color="#FF25804A"/>
    <SolidColorBrush x:Key="WarningText" Color="#FFF4B45C"/>
    <SolidColorBrush x:Key="WarningMark" Color="#FFE59A2D"/>
    <SolidColorBrush x:Key="WarningWash" Color="#FF3D2F12"/>
    <SolidColorBrush x:Key="ErrorText" Color="#FFFF8F8F"/>
    <SolidColorBrush x:Key="ErrorMark" Color="#FFF05A5A"/>
    <SolidColorBrush x:Key="ErrorWash" Color="#FF4A2121"/>
    <SolidColorBrush x:Key="DangerFill" Color="#FFC0392B"/>

    <!-- Monospace boxes (Airport conditions, NOTAMs) -->
    <SolidColorBrush x:Key="CodeBackground" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="CodeBorder" Color="#FF3A3A3A"/>
</ResourceDictionary>
