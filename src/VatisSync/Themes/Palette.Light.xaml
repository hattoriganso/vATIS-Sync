<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every color the app uses, by role. Styles and windows refer to these names, never to a hex value, so a
         second palette (dark, or Windows High Contrast) only has to define the same names. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="{x:Static SystemColors.ControlLightColor}"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="{x:Static SystemColors.ControlDarkColor}"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="{x:Static SystemColors.ControlTextColor}"/>
    <!-- Secondary text. Dark enough to read on the gray sidebar and on the pale blue selection (about 5:1). -->
    <!-- Near-black slate for text on tinted boxes and in the monospace boxes -->
    <SolidColorBrush x:Key="TextStrong" Color="#FF1F2937"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF595959"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF444444"/>
    <SolidColorBrush x:Key="OnFill" Color="#FFFFFFFF"/>

    <!-- Controls (buttons, inputs, tabs, dropdowns) -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FFE1E1E1"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#FFADADAD"/>
    <SolidColorBrush x:Key="ControlBorderStrong" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#FFDCDCDC"/>
    <SolidColorBrush x:Key="TabBackground" Color="#FFF0F0F0"/>

    <!-- The one blue. Fills and outlines use Accent; blue text uses AccentText, which is darker so it reads on gray. -->
    <SolidColorBrush x:Key="Accent" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF106EBE"/>
    <SolidColorBrush x:Key="AccentDark" Color="#FF005499"/>
    <SolidColorBrush x:Key="AccentText" Color="#FF0B5CAD"/>
    <SolidColorBrush x:Key="AccentWash" Color="#FFC4DDF0"/>
    <SolidColorBrush x:Key="AccentWashHover" Color="#FFE5F1FB"/>
    <SolidColorBrush x:Key="AccentWashPressed" Color="#FFCCE4F7"/>
    <!-- Text drawn on top of AccentWash (the selected row) -->
    <SolidColorBrush x:Key="OnAccentWash" Color="{x:Static SystemColors.ControlTextColor}"/>

    <!-- Status: text, mark (dots and borders), wash (soft background), fill (big buttons) -->
    <SolidColorBrush x:Key="SuccessText" Color="#FF15803D"/>
    <SolidColorBrush x:Key="SuccessMark" Color="#FF16A34A"/>
    <SolidColorBrush x:Key="SuccessWash" Color="#FFEAF6EE"/>
    <SolidColorBrush x:Key="SuccessFill" Color="#FF15803D"/>
    <SolidColorBrush x:Key="WarningText" Color="#FF9A5200"/>
    <SolidColorBrush x:Key="WarningMark" Color="#FFD97706"/>
    <SolidColorBrush x:Key="WarningWash" Color="#FFFDF3DC"/>
    <SolidColorBrush x:Key="ErrorText" Color="#FFB42323"/>
    <SolidColorBrush x:Key="ErrorMark" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="ErrorWash" Color="#FFFBE9E9"/>
    <SolidColorBrush x:Key="DangerFill" Color="#FFB91C1C"/>

    <!-- Monospace boxes (Airport conditions, NOTAMs) -->
    <SolidColorBrush x:Key="CodeBackground" Color="#FFF8FAFC"/>
    <SolidColorBrush x:Key="CodeBorder" Color="#FFE2E8F0"/>
</ResourceDictionary>
