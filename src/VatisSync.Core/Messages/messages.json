{
  // Every message vATIS-Sync shows to the user: the bar along the bottom, the status line at the top, and the Log.
  //
  // Placeholders: {name} is replaced by a value. {count?airport|airports} picks the first word when the value is 1
  // and the second otherwise. Only the placeholders listed above each message exist, and a misspelled one is caught
  // by a test. To show a literal brace, don't: braces are always placeholders.
  //
  // Messages are built into the app, so a change here shows up the next time it is built.

  // ---------------------------------------------------------------------------------------------------------------
  // Reading the airports from the open vATIS profile (shown when the app starts, and after "Retry now" / "Refresh")
  // ---------------------------------------------------------------------------------------------------------------

  // Left panel, while the very first try is running.
  "discovery.searching": "Looking for vATIS…",

  // Left panel, while a retry is running.
  "discovery.searching-again": "Trying vATIS again…",

  // Left panel, counting down to the next try.   {seconds}
  "discovery.waiting": "Couldn't sync with vATIS, retrying in {seconds} {seconds?second|seconds}.",

  // Yellow bar at the bottom while vATIS can't be read. The number counts down by itself.   {seconds}
  "discovery.waiting-bar": "Couldn't sync with vATIS, retrying in {seconds} {seconds?second|seconds}. Make sure vATIS is open.",

  // The same bar while a retry is actually running.
  "discovery.trying-bar": "Couldn't sync with vATIS. Trying again…",

  // Left panel once vATIS has been read.
  "discovery.found": "Airports read from your vATIS profile.",

  // Log, one line for each failed try.   {problem} is the reason (see discovery.problem), {attempt} is the try number, {seconds}
  "discovery.attempt-failed": "{problem} Attempt {attempt} failed; retrying in {seconds} {seconds?second|seconds}.",

  // The reason given in the line above when vATIS can't be reached at all.
  "discovery.problem": "Couldn't reach vATIS.",

  // Log, every time vATIS is read.   {count} airports found, {new} of them new to the list, {failed} failed tries before this one (the second text is used when there were any)
  "discovery.read": "Read your vATIS profile: {count} D-ATIS {count?airport|airports} found, {new} new.",
  "discovery.read-after-failures": "Read your vATIS profile: {count} D-ATIS {count?airport|airports} found, {new} new, after {failed} failed {failed?try|tries}.",

  // Log, every time vATIS is read, when the profile has stations that the app ignores because they have no preset named
  // exactly D-ATIS (a new, empty station is like this).   {count}, {stations} such as "KJFK, KMIA_D"
  "discovery.no-preset": "Skipped {count} {count?station|stations} in your vATIS profile with no preset named \"D-ATIS\": {stations}.",

  // Yellow bar and Log when vATIS answers but nothing in the profile uses D-ATIS.
  "discovery.empty": "vATIS is open, but none of the stations in your profile use D-ATIS.",

  // Green bar when airports were added to the list.   {count}
  "discovery.added": "Added {count} {count?airport|airports} from your vATIS profile.",

  // Green bar after "Refresh" when some listed airports are no longer in the profile.   {count}
  "discovery.stale": "{count} {count?airport is|airports are} no longer in your vATIS profile.",

  // Green bar after "Refresh" when nothing changed.
  "discovery.matches": "Your airport list matches your vATIS profile.",

  // ---------------------------------------------------------------------------------------------------------------
  // The small status word under each airport in the list on the left
  // ---------------------------------------------------------------------------------------------------------------

  // In the profile, nothing written yet (the sync is not running, or has not reached this airport).
  "airport.ready": "Ready",

  // The real-world D-ATIS text has been written into its vATIS station(s), but the ATIS is not connected yet.
  "airport.synced": "Synced",

  // At least one of its stations is connected, so the ATIS is live on VATSIM.
  "airport.connected": "Connected",

  // No longer in the vATIS profile (its settings are kept).
  "airport.stale": "Stale",

  // A change you disregarded is still waiting: vATIS differs from the real-world ATIS (shown over Connected and Synced).
  "airport.desynced": "Desynced",

  // A station is connected, but there is no current real-world D-ATIS for it (shown over Connected).
  "airport.no-datis": "No D-ATIS",

  // A runway change is waiting for your review: nothing has been written for this airport (shown over every other word).
  "airport.review": "Needs review",

  // ---------------------------------------------------------------------------------------------------------------
  // The Summary tab of an airport: the D-ATIS text and where it comes from
  // ---------------------------------------------------------------------------------------------------------------

  // While the real-world D-ATIS is being downloaded.
  "summary.loading": "Loading the real-world D-ATIS…",

  // When no station of the airport is in the vATIS profile (so there is nothing to show).
  "summary.no-stations": "No D-ATIS station for this airport is in your vATIS profile right now, so there is nothing to show.",

  // Next to a station when there is no real-world D-ATIS for it.   {station}
  "summary.no-data": "There is no real-world D-ATIS for {station} right now.",

  // Next to a station when the real-world D-ATIS is too old to use.   {station}
  "summary.too-old": "The real-world D-ATIS for {station} is too old to use.",

  // Yellow note when the download failed but an older copy is shown.   {reason}
  "summary.fetch-failed-cached": "Couldn't get a fresh real-world D-ATIS ({reason}). Showing the last copy.",

  // Yellow note when the download failed and there is nothing to show.   {reason}
  "summary.fetch-failed": "Couldn't get the real-world D-ATIS ({reason}).",

  // Under a station: which ATIS information this is and how old it is.   {letter}, {age}
  "summary.source": "Information {letter}, issued {age}.",
  "summary.source-no-letter": "Issued {age}.",

  // The age in the line above.   {count}
  "summary.age-now": "just now",
  "summary.age-minutes": "{count} {count?minute|minutes} ago",
  "summary.age-hours": "{count} {count?hour|hours} ago",

  // Under each station's name on the Summary tab: where it stands in vATIS.   {time} is when the text was written
  "summary.status-connected": "Connected: live on the network.",
  "summary.status-synced": "Synced: written into vATIS at {time}, not connected.",
  "summary.status-ready": "Ready: nothing written into vATIS yet.",

  // Small grey note under the tabs. Mentions what the preview leaves out.
  "summary.note": "Shows what would be written into vATIS using this airport's settings. Your vATIS contractions and text you deleted by hand are not shown.",

  // Shown for a section that has no text.
  "summary.nothing": "(nothing)",

  // ---------------------------------------------------------------------------------------------------------------
  // Syncing D-ATIS into vATIS (status line at the top, Log, and the bar when something goes wrong)
  // ---------------------------------------------------------------------------------------------------------------

  // Status line (headline and the small text under it) for each stage.
  "status.stopped.headline": "Stopped",
  "status.stopped.detail": "Press Start to sync real-world D-ATIS into vATIS.",
  "status.starting.headline": "Starting",
  "status.starting.detail": "Getting ready…",
  "status.waiting.headline": "Waiting for vATIS",
  "status.waiting.detail": "Waiting for vATIS to open.",
  "status.syncing.headline": "Syncing",
  "status.syncing.detail": "Updating your ATIS stations…",
  "status.idle.headline": "Up to date",
  "status.idle.detail": "Waiting for the next refresh.",

  // What the status line says during each step of a sync.
  "engine.starting": "Starting…",
  "engine.waiting": "Waiting for vATIS…",
  "engine.loading": "Loading D-ATIS…",
  "engine.refreshing": "Refreshing D-ATIS…",

  // Red bar and status line when vATIS is lost during a sync. The app keeps trying by itself.
  "engine.unreachable": "Couldn't sync with vATIS. Make sure it is open. Retrying…",

  // Log, with the technical reason.   {reason}
  "engine.unreachable-log": "vATIS unavailable: {reason}",

  // Red bar and status line when something unexpected stops a sync. The app keeps trying by itself.
  "engine.unexpected": "Something went wrong while syncing. Retrying…",

  // Log, with the technical details.   {error}
  "engine.unexpected-log": "Unexpected error: {error}",

  // Log, when the app could not find vATIS to start it for you.
  "engine.vatis-not-found": "vATIS wasn't found in its usual place; waiting for you to start it.",

  // Log, when real-world D-ATIS could not be downloaded.   {reason}
  "engine.datis-failed-cached": "Couldn't download D-ATIS ({reason}); using the last good copy.",
  "engine.datis-failed-none": "Couldn't download D-ATIS ({reason}); there is no copy to use.",

  // Log, when a runway change starts waiting for your review. The sync goes on with the other airports.   {station} {summary}
  "engine.review-waiting": "{station}: a runway change is waiting for your review. {summary}",

  // Log, after you decide.   {station}, {summary} what would have changed
  "engine.approval-kept": "{station}: kept the current ATIS. {summary}",
  "engine.approval-applied": "{station}: update approved. {summary}",

  // Log, when the log folder cannot be opened from the Log panel.   {path}, {reason}
  "log.folder-open-failed": "Couldn't open the log folder {path}: {reason}",

  // Log, when you press Resync on an airport you disregarded.   {station} is the airport
  "engine.resync": "{station}: resync requested, checking the real-world ATIS now",

  // Log, a station disregarded for the session when a change that would have asked arrives.   {station}, {summary}
  "engine.disregarded-for-session": "{station}: change not applied, vATIS now differs from the real-world ATIS. {summary}",

  // Log, when a station is connected or disconnected.   {station}, {limit}
  "engine.connected": "Connected {station}.",
  "engine.disconnected-limit": "Disconnected {station} (over the {limit}-connection limit).",

  // Log, when text you deleted by hand is kept deleted.   {count}, {station}
  "engine.keeping-deletions": "Keeping {count} manual {count?deletion|deletions} for {station}.",

  // ---------------------------------------------------------------------------------------------------------------
  // Settings and rules files, and other things that go wrong in the app itself
  // ---------------------------------------------------------------------------------------------------------------

  // Yellow bar and Log.   {path}, {reason}
  "settings.read-failed": "Couldn't read your settings file, so the default settings are in use. ({path}: {reason})",
  "settings.save-failed": "Couldn't save your settings. ({path}: {reason})",

  // Yellow bar and Log, about the file of your own rules.   {path}, {reason}
  "rules.invalid-file": "Your rules file wasn't understood, so it was ignored: {path}. How it should look: https://github.com/hattoriganso/vATIS-Sync/blob/main/docs/rules.md",
  "rules.read-failed": "Couldn't read your rules file {path}: {reason}",
  "rules.open-failed": "Couldn't open your rules file {path}: {reason}",

  // Small orange text under the status line while syncing, after a setting is changed.
  "settings.apply-next-start": "Changes apply the next time you press Start.",

  // Yellow bar and Log, about an airport's own settings file in the Airports folder.   {icao}, {path}, {reason}
  "airports.read-failed": "Couldn't read the settings file for {icao}, so its default settings are in use. ({path}: {reason})",
  "airports.save-failed": "Couldn't save the settings for {icao}. ({path}: {reason})",

  // Yellow bar and Log, when the Airports folder itself can't be read.   {path}, {reason}
  "airports.folder-failed": "Couldn't read the Airports folder. ({path}: {reason})",

  // Log, once, when settings kept by an older version are moved into the Airports folder.   {count}
  "airports.imported": "Moved the settings of {count} {count?airport|airports} into the Airports folder.",

  // Log, when the Windows startup option can't be changed.
  "startup.failed": "Couldn't change the Windows startup setting.",

  // Log, when the text typed in "Connect only these airports" is not an airport code.   {text}
  "connect.invalid-airport": "\"{text}\" is not a 4-letter airport code (for example KSFO).",

  // Red bar when something unexpected goes wrong in the window. The app keeps running.   {path} is the file with the details
  "app.unexpected": "Something went wrong, but vATIS-Sync kept running. Details were saved to {path}.",
  "app.unexpected-no-file": "Something went wrong, but vATIS-Sync kept running.",

  // Log, with the technical details.   {type}, {message}
  "app.unexpected-log": "Unexpected error ({type}): {message}"
}
